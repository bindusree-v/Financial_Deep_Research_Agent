{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ai-financial-decision-agent.onrender.com/api/:path*"
    },
    { "source": "/login",     "destination": "/ui/login.html" },
    { "source": "/history",   "destination": "/ui/history.html" },
    { "source": "/activity",  "destination": "/ui/activity.html" },
    { "source": "/dashboard", "destination": "/ui/dashboard.html" },
    { "source": "/profile",   "destination": "/ui/profile.html" },
    { "source": "/admin",     "destination": "/ui/admin.html" },
    { "source": "/",          "destination": "/ui/index.html" }
  ]
}
